PORT=3000
ADMIN_EMAIL=you@yourcompany.com
ADMIN_PASSWORD=change-me-please
# DB_PATH=./data/shedbuilder.db
# UPLOAD_DIR=./uploads
# SESSION_SECRET=long-random-string
# COOKIE_SECURE=true
# FILES_DIR=./data/files          # contract templates + signed contracts (private — back this up with data/)
# MODULES=all                     # first run only: all | none | crm,pos,orders (any mix)
# DEVOPS_EMAIL=dev@yourcompany.com  # developer login: the only one that sees Settings → Modules
# DEVOPS_PASSWORD=long-password-here
# MESSAGING_TEST_MODE=1           # log texts/emails in the CRM without sending them
# Off-server backups (S3-compatible: Cloudflare R2, Backblaze B2, AWS S3…)
# BACKUP_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# BACKUP_S3_BUCKET=shed-builder-backups
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
# BACKUP_S3_PREFIX=company-name
# BACKUP_HOUR=3
